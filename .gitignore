.env
exports/
__pycache__/
*.pyc
*.pyo
logs/*.jsonl
# Rotated backups (logs/logger.py::_rotate -- query_log.jsonl.1, .2, ...,
# audit_log.jsonl.1, .2, ...) do NOT match "logs/*.jsonl" above (their
# name ends in ".<N>", not ".jsonl") and were being left untracked-but-
# not-ignored -- one `git add -A` away from committing real user
# questions and generated SQL from the audit trail. Match them explicitly.
logs/*.jsonl.*
# SQLite, including its sidecars. "*.db" alone does NOT match
# sessions.db-wal or sessions.db-shm -- and the write-ahead log is where
# recently-written pages live, so on a real deployment it is the file most
# likely to hold questions and generated SQL that have not been
# checkpointed into the main database yet. Both were committed once,
# exactly the way the rotated audit logs above nearly were: one `git add
# -A` in a working copy where the server had run.
*.db
*.db-wal
*.db-shm
*.db-journal
.venv/
dist/
build/
*.egg-info/
.config.example
# Project-specific configuration (contains domain data — never commit)
project_config/
presentation

# Draft output of database/schema_inspector_cli.py -- may contain real
# sample values fetched from a live warehouse (see SchemaInspector.
# draft_schema_yaml's warning); never commit it.
project_config_draft/

# Real evaluation golden set / baselines (contains customer questions — never commit)
eval_data/

# Coverage artefacts
.coverage
.coverage.*
htmlcov/

