# Environment variables for local-sql-agent
# Fill in your actual values. NEVER commit .env!

# Ollama
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3

# SQL Server
DB_CONNECTION_URL=mssql+pyodbc://username@server:1433/Auction_DM?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# Optional
QUERY_TIMEOUT_SECONDS=60
MAX_ROWS_RETURNED=1000
LOG_DIR=logs
EXPORT_DIR=exports
