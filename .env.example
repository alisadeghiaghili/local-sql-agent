# Environment variables for local-sql-agent
# Fill in your actual values. NEVER commit .env!

# OpenAI-compatible LLM endpoint (vLLM / LM Studio / llama.cpp / a local
# gpt-oss server, or OpenAI's own hosted API -- selected entirely by
# base_url). This is the trivial single-endpoint case; see LLM_ENDPOINTS/
# LLM_ROUTES below for routing across more than one endpoint.
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_MODEL=gpt-oss-20b
OPENAI_API_KEY=

# ── SQL Server ────────────────────────────────────────────────────────────
DB_CONNECTION_URL=mssql+pyodbc://username@server:1433/Auction_DM?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# ── Runtime behaviour ─────────────────────────────────────────────────────
# Set to 1/true/yes to run tests/integration/test_executor_live.py against
# THIS DB_CONNECTION_URL (a real database). Left unset, those tests are
# skipped cleanly -- see that file's module docstring. Not read by the
# application itself, only by that opt-in test suite.
# RUN_LIVE_DB_TESTS=1

QUERY_TIMEOUT_SECONDS=60
MAX_ROWS_RETURNED=1000
# Row cap injected into generated SQL (as TOP n) when it has no row-limit
# clause of its own. Optional — defaults to MAX_ROWS_RETURNED if unset.
# DEFAULT_TOP_N=1000
LOG_DIR=logs
EXPORT_DIR=exports
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=256

# Rate limiting (API). Bucketed per (authenticated principal, IP) pair --
# see api/middleware.py's RateLimitMiddleware docstring -- so in the
# common deployment shape (one web UI, one shared service key, many
# analysts behind it) every analyst using that UI still shares ONE
# bucket. 600/60s = 10 requests/sec sustained, sized for roughly 30
# analysts each firing an interactive query (a human clicking "ask"
# every few seconds, not a batch client) at once: 30 x one request per
# 3s = 600/min. Raise this if legitimate use is getting 429s (more
# analysts, or a UI that fires several requests per interaction); lower
# it for a deployment with only a handful of analysts that wants a
# tighter ceiling on a misbehaving client or scripting mistake. See
# config.Settings.rate_limit_requests for the full reasoning.
RATE_LIMIT_REQUESTS=600       # requests allowed per window, PER (principal, ip) bucket
RATE_LIMIT_WINDOW_SEC=60      # window size in seconds
RATE_LIMIT_BURST=40           # extra burst tokens above sustained rate -- absorbs one
                               # page load's worth of parallel calls without eating
                               # into the sustained rate; raise/lower alongside REQUESTS
MAX_CONCURRENT_REQUESTS=10   # max parallel /query requests before 503

# Comma-separated IPs of reverse proxies allowed to supply X-Forwarded-For
# / X-Real-IP for rate-limiting purposes. Leave empty (default) unless this
# server sits behind a known proxy — otherwise a direct client can bypass
# its own per-IP rate limit by sending a different made-up
# X-Forwarded-For value on every request.
# Example: TRUSTED_PROXY_IPS=10.0.0.5,10.0.0.6
TRUSTED_PROXY_IPS=

# Max distinct client IP buckets the rate limiter keeps in memory at once.
# Beyond this, the least-recently-seen bucket is evicted to make room for
# a new one, bounding memory use against a flood of distinct/spoofed IPs.
RATE_LIMIT_MAX_TRACKED_IPS=10000

# Schema auto-discovery
# Set AUTO_DISCOVER_SCHEMA=true to inspect the live database on startup
# and build relationship hints automatically (requires DB_CONNECTION_URL).
# If project_config/relationships.yaml exists, that file is used instead.
AUTO_DISCOVER_SCHEMA=false
SCHEMA_CACHE_TTL=3600         # seconds to cache discovered schema (0 = no cache)

# Setup wizard LLM settings (optional overrides for the setup wizard only)
WIZARD_LLM_PROVIDER=openai    # openai | mock
WIZARD_LLM_MODEL=gpt-oss-20b  # model name (overrides per-provider model)
WIZARD_LLM_BASE_URL=          # optional: custom OpenAI-compatible endpoint
WIZARD_LANGUAGE=fa            # default language for alias generation (fa | en | both)

# Production engine LLM router (llm/router.py). Which backend answers
# every task (SQL generation, interpretation, assumption extraction) by
# default. "openai" (the default) routes through llm/endpoints.py -- see
# LLM_ENDPOINTS/LLM_ROUTES below for anything beyond the trivial
# single-endpoint case, and LLM_ALLOW_REMOTE below for the governance gate.
LLM_PROVIDER=openai            # openai | mock

# Sending schema, business-rule text, or query-result rows to an untrusted
# endpoint is NOT enabled just by setting OPENAI_BASE_URL/LLM_ENDPOINTS
# above -- this product's premise is "runs on your infrastructure". Set
# this to true only as a deliberate, per-deployment opt-in; every call to
# an untrusted endpoint made while it is true is written to the audit trail.
LLM_ALLOW_REMOTE=false

# Explicit trust override for the single "default" endpoint (OPENAI_BASE_URL
# above). Unset (default) auto-detects: loopback/private/*.local addresses
# are trusted, a public hostname (e.g. api.openai.com) is not. Set
# true/false to override that heuristic for this specific deployment.
# LLM_TRUSTED=true

# Additional named endpoints beyond the trivial "default" one, as a JSON
# array -- each entry needs at least name/base_url/model ("api_key" and
# "trusted" are optional). Pair with LLM_ROUTES below to route specific
# tasks to specific endpoints with a fallback chain. Example:
# LLM_ENDPOINTS=[{"name":"local","base_url":"http://localhost:8000/v1","model":"gpt-oss-20b"},{"name":"hosted","base_url":"https://api.openai.com/v1","model":"gpt-4o-mini","api_key":"sk-..."}]
# LLM_ROUTES={"sql_generation":["local","hosted"],"interpretation":["local"]}

# Optional per-task latency budget (seconds), applied uniformly to every
# TaskType by LLMRouter.from_settings(). Unset (default) disables it.
# LLM_TASK_BUDGET_SECONDS=30

# Phase 2 task 3 feature flag: ask for one constrained JSON object
# ({"sql", "out_of_scope", "confidence", "assumptions"}) instead of free
# text + clean_sql regex surgery. Off until the golden-set evaluation
# (python -m eval.cli run --live --structured) justifies flipping it --
# see the Phase 2 report for whether that evaluation has been run yet.
LLM_STRUCTURED_OUTPUT=false

# JSONL log rotation (logs/logger.py::save_log, observability/audit.py)
# Applies to both query_log.jsonl (REPL) and audit_log.jsonl (API audit
# trail -- the ONLY source of real accuracy/latency numbers a first
# production deployment will ever produce; losing its earliest records to
# a rotation nobody was watching is silent and unrecoverable). Read
# through config.py's Settings (log_max_bytes / log_backup_count) at call
# time, like every other setting.
# Size cap per log file, in bytes, before it is rotated (query_log.jsonl ->
# query_log.jsonl.1, etc). <= 0 disables rotation (unbounded growth).
# 50 MiB x 20 backups (below) = ~1 GiB / ~1M records retained at this
# project's observed ~1 KB/record average -- raise LOG_MAX_BYTES if real
# traffic runs materially larger per record than that; raise
# LOG_BACKUP_COUNT if a deployment's total volume could plausibly exceed
# ~1M records before someone archives the file. Lower either only if disk
# space is a tighter constraint than audit history, which for a
# compliance/analysis log is rarely the right trade.
LOG_MAX_BYTES=52428800
# Number of rotated backups to retain. The oldest beyond this count is
# deleted on each rotation. <= 0 keeps no history (file is cleared instead
# of shifted to .1 on rotation).
LOG_BACKUP_COUNT=20

# ── Evaluation harness regression gate (eval/baseline.py) ────────────────
# What counts as a regression when `python -m eval.cli run --baseline ...`
# compares a new golden-set run against a saved one. Tuning, not a fixed
# technical fact -- how much accuracy/latency variance is tolerable is a
# property of THIS deployment's hardware and traffic. Each has its own
# `python -m eval.cli run --max-...` flag that overrides these per
# invocation without touching the environment.
#
# Percentage-point drop in accuracy (baseline minus current) above which a
# run is flagged. Raise this to tolerate noisier golden-set accuracy;
# lower it to catch smaller regressions sooner.
EVAL_MAX_ACCURACY_DROP_PCT=5.0
# Relative percentage increase in p95 latency (vs baseline) above which a
# run is flagged. Raise this on slower or more variable hardware where
# some latency drift run-to-run is normal; lower it on fast, dedicated
# hardware where a latency regression should stand out immediately.
EVAL_MAX_LATENCY_P95_INCREASE_PCT=20.0
# Absolute increase in guard-rejected cases (vs baseline) above which a
# run is flagged. Defaults to 0 -- any new guard rejection is safety-
# relevant (generated SQL that used to pass the security guard no longer
# does). Raise only if you have a specific, understood reason more guard
# rejections are expected.
EVAL_MAX_GUARD_REJECTION_INCREASE=0

# ── Phase 8: API-key authentication ─────────────────────────────────────
# Named API keys, not JWT/OIDC -- see docs/api-contract-v2.md's
# authentication section for the rationale. Fail-closed by default: if
# AUTH_REQUIRED=true (the default) and API_KEYS_JSON has no configured
# keys, the server refuses to start rather than run with a front door
# nobody can open.
#
# Issue a key with: python scripts/issue_api_key.py --id analyst-1 --name "Jane Analyst"
# It prints the raw key ONCE (copy it -- it is not recoverable afterwards)
# and the API_KEYS_JSON entry to paste below. Only the SHA-256 hex digest
# of a key is ever stored here -- never the raw key itself.
#
# API_KEYS_JSON=[{"id":"analyst-1","name":"Jane Analyst","key_sha256":"<64-hex-char digest>"}]
API_KEYS_JSON=

# Whether every route except GET /health requires a valid API key.
# Defaults to true (fail-closed). Setting this to false is a deliberate
# escape hatch (local development, or a deployment that already sits
# behind its own perimeter auth) -- the server logs a WARNING on every
# startup while it is false, not just the first, so a disabled front door
# is never quiet in the logs. Do not set this to false in production.
AUTH_REQUIRED=true

# Whether /docs, /redoc, and /openapi.json are served without credentials.
# Defaults to false: the generated API documentation describes exactly
# what an authenticated caller can do to production data, so it requires
# the same authentication as every other protected route by default.
APP_DOCS_PUBLIC=false
